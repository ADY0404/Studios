# LinkStudio Environment Configuration Template
DEBUG=False
SECRET_KEY=your-django-production-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database (MariaDB / SkySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=linkstudio
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=serverless-europe-west2.sysp0000.db2.skysql.com
DB_PORT=4048
DB_SSL=True

# Cloudinary (Persistent Photo & Video Media Storage)
# You can provide either the 3 separate credentials:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# OR the single CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
